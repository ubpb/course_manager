/ <%# locals: (filter:, filters_partial:, always: false) -%>

/ Filter panel. With `always: false` (frontend): inline right-column sidebar at >=lg,
/ right-side offcanvas at <lg. With `always: true` (admin): always a right-side
/ offcanvas that opens on request. `filters_partial` is the controller-specific
/ filter form, e.g. "frontend/offers/filter_form".
- offcanvas_class = always ? "offcanvas offcanvas-end" : "offcanvas-lg offcanvas-end"
- header_visibility_class = always ? "" : "d-lg-none"
div id="offcanvas-filters" class=offcanvas_class tabindex="-1" aria-labelledby="offcanvas-filters-label"
  .offcanvas-header.border-bottom class=header_visibility_class
    h5#offcanvas-filters-label.offcanvas-title = "Filter"
    button.btn-close(type="button" data-bs-dismiss="offcanvas" data-bs-target="#offcanvas-filters")
  .offcanvas-body.d-block
    = render filters_partial, filter: filter
