/ <%# locals: (offers:) -%>

- offers.each.with_index do |offer, i|
  - details_path = frontend_offer_path(offer)
  - margin_class = i == 0 ? "mt-0" : "mt-4"

  .card(id=dom_id(offer) class=margin_class)
    .card-header(style="background-color: var(--bs-light)")
      = link_to details_path, class: "text-decoration-none fw-bold" do
        h5.mb-0(style="color: var(--upb-irisviolett)") = offer.title
    .card-body
      .d-flex.justify-content-between.align-items-center
        div
          - if offer.description.present?
            .mb-3 = truncate(strip_tags(render_markdown(offer.description)), length: 200)

          = render "topic_and_target_group_badges", offer: offer

          - events_on_request_message = capture do
            div
              i.fa-solid.fa-circle-info.me-1
              == t("frontend.events.on_request_message", contact_url: frontend_contact_path)

          - if offer.course?
            .mt-3
              .fw-bold = "Nächste Termine"
              / Filtered here rather than by a query, which would bypass the
              / events the controller preloads for all offers.
              - events = offer.upcoming_events.select(&:published?)
              - if events.any?
                = render "listing_events", offer: offer, events: events
                - if offer.events_on_request?
                  .fst-italic = events_on_request_message
              - else
                i.fa-regular.fa-calendar.me-1
                = t("frontend.events.no_events_message")
                - if offer.events_on_request?
                  .fst-italic = events_on_request_message
        div
          = link_to details_path, class: "btn btn-outline-primary btn-sm" do
            i.fa-solid.fa-chevron-right.fa-fw.me-1
