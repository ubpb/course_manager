/ <%# locals: (offers:) -%>

- offers.each.with_index do |offer, i|
  - details_path = frontend_offer_path(offer)
  - margin_class = i == 0 ? "mt-0" : "mt-3"

  .card(class=margin_class)
    .card-body
      .d-flex.justify-content-between.align-items-center
        div
          = link_to details_path do
            h4.mb-3 = offer.title

          = render "topic_and_target_group_badges", object: offer

          - events_on_request_message = capture do
            div
              i.fa-solid.fa-circle-info.me-1
              == t("frontend.events.on_request_message", contact_url: frontend_contact_path)

          - if offer.course?
            .mt-3
              .fw-bold = "Nächste Termine"
              - if offer.upcoming_events.any?
                ul.list-inline.mb-0
                  - offer.upcoming_events.each do |event|
                    li.list-inline-item
                      i.fa-regular.fa-calendar.fa-fw.me-1
                      = l(event.date_and_time)
                      - if event.online?
                        span.badge.text-bg-light(
                          data-controller="tooltip"
                          data-bs-toggle="tooltip"
                          data-bs-title="Online-Veranstaltung"
                        )
                          i.fa-solid.fa-globe.fa-fw.me-1
                          = "Online"
                      - else
                        span.badge.text-bg-light(
                          data-controller="tooltip"
                          data-bs-toggle="tooltip"
                          data-bs-title="Präsenzveranstaltung"
                        )
                          i.fa-solid.fa-person-chalkboard.fa-fw.me-1
                          = "Präsenz"
                - if offer.events_on_request?
                  .fst-italic = events_on_request_message
              - else
                i.fa-regular.fa-calendar.me-1
                = t("frontend.events.no_events_message")
                - if offer.events_on_request?
                  .fst-italic = events_on_request_message
        div
          = link_to details_path, class: "btn btn-outline-primary btn-sm" do
            i.fa-solid.fa-chevron-right.fa-fw.me-1
