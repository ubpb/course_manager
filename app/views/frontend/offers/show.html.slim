.d-flex.justify-content-between.align-items-center.gap-2.mb-4
  h3.mb-0.fw-bold
    = @offer.title
  div
    = link_to frontend_offers_path, class: "btn btn-outline-primary btn-sm" do
      i.fa-solid.fa-arrows-turn-right.fa-flip-horizontal.fa-fw.me-1
      span = "Alle Angebote"

- if (tatg = render("topic_and_target_group_badges", object: @offer)).present?
  .mb-3 = tatg

- has_sidebar_content = @offer.contact_info?
.row
  div(class=(has_sidebar_content ? "col-lg-8" : "col-12"))
    .card.mb-3
      .card-body
        = render "details", offer: @offer
  - if has_sidebar_content
    .col-lg-4
      - if @offer.contact_info?
        .card.mb-3
          .card-header
            h5.card-title.mb-0 = "Kontakt"
          .card-body
            - if @offer.contact_name.present?
              div
                i.fa-solid.fa-person.fa-fw.me-2
                span = @offer.contact_name
            - if @offer.contact_email.present?
              div
                i.fa-regular.fa-envelope.fa-fw.me-2
                span = mail_to @offer.contact_email
            - if @offer.contact_phone.present?
              div
                i.fa-solid.fa-phone.fa-fw.me-2
                span = link_to @offer.contact_phone, "tel:#{@offer.contact_phone}"

- if @offer.course?
  .row
    .col-12
      .card
        .card-header
          h5#events.card-title.mb-0 = "Die nächsten Termine"

        - events_on_request_alert = capture do
          .alert.alert-info.mb-0.border-0
            i.fa-solid.fa-circle-info.me-2
            == t("frontend.events.on_request_message")

        .list-group.list-group-flush
          - if @upcoming_events.present?
            - @upcoming_events.each do |event|
              .list-group-item.d-flex.justify-content-between.align-items-center(id=dom_id(event))
                div
                  = render "frontend/events/details", event: event
                div
                  - if event.registration_required?
                    - if event.full?
                      .p-2.text-muted = "Keine freien Plätze mehr"
                    - elsif event.registration_closed?
                      .p-2.text-muted = "Anmeldung nicht mehr möglich"
                    - else
                      .d-grid.gap-2
                        = link_to "Jetzt anmelden", frontend_event_registrations_path(event), class: "btn btn-primary"
                        - if event.limited?
                          .text-center = "Noch #{event.no_of_free_spaces} freie Plätze verfügbar"
                  - else
                    .p-2.text-muted = "Keine Anmeldung erforderlich"
              - if @offer.events_on_request?
                = events_on_request_alert
          - else
            .alert.alert-warning.mb-0.border-0
              i.fa-regular.fa-calendar.me-2
              = t("frontend.events.no_events_message")
            - if @offer.events_on_request?
              = events_on_request_alert
