/ <%# locals: (event:) -%>

li
  i.fa-regular.fa-calendar.fa-fw.me-1
  = l(event.date_and_time)
  - if event.online?
    span.badge.text-bg-light(
      data-controller="tooltip"
      data-bs-toggle="tooltip"
      data-bs-title="Online-Veranstaltung"
    )
      i.fa-solid.fa-globe.fa-fw.me-1
      = "Online"
  - else
    span.badge.text-bg-light(
      data-controller="tooltip"
      data-bs-toggle="tooltip"
      data-bs-title="Präsenzveranstaltung"
    )
      i.fa-solid.fa-person-chalkboard.fa-fw.me-1
      = "Präsenz"
