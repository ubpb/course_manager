.d-flex.justify-content-between.align-items-center.gap-2.mb-4
  h3.mb-0.fw-bold
    = "Unsere Schulungs- & Beratungsangebote"

.row
  .col-lg-8
    = render "frontend/application/filter_bar", filter: @filter, chips: frontend_offer_filter_chips(@filter)
    - if @offers.present?
      = render "listing", offers: @offers
    - else
      .card: .card-body
        .text-muted = "Keine Angebote vorhanden"
  .col-lg-4
    .card
      .card-header
        h5.card-title.mb-0.card-title Filter
      .card-body
        = render "frontend/application/filter_offcanvas", filter: @filter, filters_partial: "frontend/offers/filter_form"
