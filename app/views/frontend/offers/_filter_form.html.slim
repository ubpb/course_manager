/ <%# locals: (filter:) -%>

- scopes = [["Alle", nil], ["Schulungen", "courses"], ["Beratungen", "consultings"]]
- topics = Topic.order(:position)
- target_groups = TargetGroup.order(:position)

= simple_form_for filter, as: :filter, url: frontend_offers_path, method: :get, html: { data: { controller: "filter-form" } } do |form|
  = form.input :scope, as: :select, collection: scopes, required: false, prompt: false
  - if filter&.scope == "courses"
    = form.input :with_upcoming_events, as: :boolean, required: false
  = form.input :title, required: false
  - if topics.present?
    = form.input :topics, as: :check_boxes, collection: topics, required: false
  - if target_groups.present?
    = form.input :target_groups, as: :check_boxes, collection: target_groups, required: false

