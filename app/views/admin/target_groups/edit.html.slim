/ Only reached without Turbo; the list opens the form in a modal. Submitting
/ through Turbo would get the answers meant for the modal.
= simple_form_for [:admin, @target_group], data: {turbo: false} do |form|
  .card.card-shadowed
    .card-header.d-flex.align-items-center.gap-2
      h5.card-title.mb-0 = "Zielgruppe bearbeiten"
      .ms-auto
      = link_to admin_target_groups_path, class: "btn btn-link btn-sm" do
        i.fa-solid.fa-times
    .card-body
      = form.input :title
    .card-footer
      .d-flex.gap-2.flex-column.flex-md-row
        = form.submit t("admin.application.btn_save"), class: "btn btn-primary"
        = link_to t("admin.application.btn_cancel"), admin_target_groups_path, class: "btn btn-outline-secondary"
