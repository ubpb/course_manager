/ Admin breadcrumb: only the path inside the admin area. The last item is the
/ current page and no link.
.d-flex.flex-column.flex-md-row.justify-content-md-between.align-items-md-center
  nav.order-2.order-md-1(aria-label="breadcrumb")
    ol.breadcrumb.p-0.m-0
      - breadcrumb.each.with_index(1) do |b, i|
        - if i == breadcrumb.count
          li.breadcrumb-item.active(aria-current="page") = b[:label]
        - else
          li.breadcrumb-item
            - if b[:path].present?
              = link_to b[:label], b[:path]
            - else
              = b[:label]
  div.order-1.order-md-2
    .app-name.text-uppercase.ms-md-2
      = link_to root_path do
        = t("application.app_name")
