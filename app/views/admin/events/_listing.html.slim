/ <%# locals: (events:) -%>

#bulk-action-form

= form_tag bulk_process_admin_events_path, method: :patch
  table.table(
    data-controller="checkbox-select-all"
  )
    thead
      - if @bulk_process_actions.any?
        tr
          th.table-light(colspan="8")
            .btn-toolbar.justify-content-start.flex-nowrap.align-items-center
              .ms-0 = check_box_tag :bulk_process_select_all, 0, false, "data-checkbox-select-all-target": "checkboxAll"
              .ms-2 = select_tag(:bulk_process_action, options_for_select(@bulk_process_actions), class: "form-control form-control-sm", prompt: "Aktion wählen")
              .ms-2 = submit_tag("Ausführen", class: "btn btn-primary btn-sm")
      tr
        - if @bulk_process_actions.any?
          th.table-light(width="10")
        th(colspan="2") = "Datum / Uhrzeit"
        th.text-center = "Teilnehmer"
        th.text-center = "Online?"
        th.text-center = "Statistik erfasst?"
        th.text-center = "Zertifikat erstellt?"
        th.actions = "Aktionen"
    tbody
      - events.each do |event|
        tr(id=dom_id(event))
          - if @bulk_process_actions.any?
            td.table-light = check_box_tag "bulk_process_ids[]", event.id, false, id: nil, "data-checkbox-select-all-target": "checkbox"
          td(width="1" class="#{event.published? ? "table-success" : "table-danger"}") = ""
          td
            span = l(event.date_and_time)
            span.ms-1.text-muted = "... #{date_in_words(event.date_and_time.to_date)}" if event.upcoming?
            div = link_to event.offer.title, admin_offer_events_path(event.offer)
          td.text-center
            = event.registrations_count
            - if event.max_no_of_participants.positive?
              = " / #{event.max_no_of_participants}"
            - else
              = " / ∞"
          td.text-center
            - if event.online?
              i.fa-solid.fa-check
          td.text-center
            -if event.report.present?
              i.fa-solid.fa-check
          td.text-center
            - if event.certification.present?
              i.fa-solid.fa-check
          td.actions
            .dropdown
              button.btn.btn-outline-primary.btn-sm.dropdown-toggle(type="button" data-bs-toggle="dropdown")
                i.fas.fa-cog
              ul.dropdown-menu.dropdown-menu-end
                li = link_to edit_admin_offer_event_path(event.offer, event, nav_scope: "events"), class: "dropdown-item" do
                  i.fa-solid.fa-edit.me-2
                  = "Bearbeiten"
                hr.dropdown-divider
                li = link_to admin_offer_event_registrations_path(event.offer, event, nav_scope: "events"), class: "dropdown-item" do
                  i.fa-solid.fa-users.me-2
                  = "Teilnehmer"
                li = link_to admin_offer_event_report_path(event.offer, event, nav_scope: "events"), class: "dropdown-item" do
                  i.fa-solid.fa-chart-line.me-2
                  = "Statistik"
                li = link_to admin_offer_event_certification_path(event.offer, event, nav_scope: "events"), class: "dropdown-item" do
                  i.fa-solid.fa-certificate.me-2
                  = "Zertifizierung"

/ Fix to reset indeterminate state of select-all checkboxes on turbo:load
javascript:
  document.addEventListener("turbo:load", function() {
    document.querySelectorAll("input[data-checkbox-select-all-target='checkboxAll']").forEach(function(cb) {
      cb.indeterminate = false;
    });
  })
