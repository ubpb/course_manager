/ <%# locals: (events:, offer: nil) -%>

/ One list for all events (without an offer, with an offer column) and for the
/ events of an offer, whose links lead into the events in the offer context.
- scope = offer ? NavScope::OFFER : nil
- bulk_url = offer ? bulk_process_admin_offer_events_path(offer) : bulk_process_admin_events_path
- columns = offer ? 7 : 8

#bulk-action-form

= form_tag bulk_url, method: :patch
  table.table.event-list(
    data-controller="checkbox-select-all"
  )
    thead
      - if @bulk_process_actions.any?
        tr
          th.table-light(colspan=columns)
            .btn-toolbar.justify-content-start.flex-nowrap.align-items-center
              .ms-0 = check_box_tag :bulk_process_select_all, 0, false, "data-checkbox-select-all-target": "checkboxAll"
              .ms-2 = select_tag(:bulk_process_action, options_for_select(@bulk_process_actions), class: "form-control form-control-sm", prompt: "Aktion wählen")
              .ms-2 = submit_tag("Ausführen", class: "btn btn-primary btn-sm")
      tr
        - if @bulk_process_actions.any?
          th.table-light(width="10")
        th = "Termin"
        - unless offer
          th = "Angebot"
        th.text-center = "Plätze"
        th.text-center = "Statistik"
        th.text-center = "Zertifikat"
        th = "Status"
        th.actions = "Aktionen"
    tbody
      - events.each do |event|
        - event_path = admin_offer_event_registrations_path(event.offer, event, nav_scope: scope)
        tr(
          id=dom_id(event)
          data-controller="row-link"
          data-row-link-url-value=event_path
          data-action="click->row-link#visit"
        )
          - if @bulk_process_actions.any?
            td.table-light(data-row-link-ignore) = check_box_tag "bulk_process_ids[]", event.id, false, id: nil, "data-checkbox-select-all-target": "checkbox"
          td
            = link_to l(event.date_and_time, format: "%a, %d.%m.%Y · %H:%M"), event_path, class: "fw-bold text-nowrap"
            .small.text-body-secondary
              - if event.upcoming?
                = "#{date_in_words(event.date_and_time.to_date)} · "
              = event.online? ? "Online" : "Präsenz"
          - unless offer
            td = link_to event.offer.title, offer_page_path(event.offer)
          td.text-center = event_capacity(event)
          td.text-center
            - if event.report.present?
              i.fa-solid.fa-check(title="Statistik erfasst")
            - elsif event.past?
              span.badge.text-bg-light.border = "fehlt"
            - else
              = "—"
          td.text-center
            - if event.certification.present?
              i.fa-solid.fa-check(title="Zertifikat erstellt")
            - else
              = "—"
          td = published_badge(event)
          td.actions(data-row-link-ignore)
            .dropdown
              button.btn.btn-outline-primary.btn-sm.dropdown-toggle(type="button" data-bs-toggle="dropdown")
                i.fas.fa-cog
              ul.dropdown-menu.dropdown-menu-end
                li = link_to event_path, class: "dropdown-item" do
                  i.fa-solid.fa-users.me-2
                  = "Teilnehmer"
                li = link_to admin_offer_event_report_path(event.offer, event, nav_scope: scope), class: "dropdown-item" do
                  i.fa-solid.fa-chart-line.me-2
                  = "Statistik"
                li = link_to admin_offer_event_certification_path(event.offer, event, nav_scope: scope), class: "dropdown-item" do
                  i.fa-solid.fa-certificate.me-2
                  = "Zertifikat"
                li = link_to edit_admin_offer_event_path(event.offer, event, nav_scope: scope), class: "dropdown-item" do
                  i.fa-solid.fa-edit.me-2
                  = "Termindaten"
                hr.dropdown-divider
                li = link_to duplicate_admin_offer_event_path(event.offer, event, nav_scope: scope), data: {turbo_method: :get, turbo_confirm: "Termin duplizieren? Datum und Uhrzeit wird auf JETZT voreingestellt und muss geändert werden."}, class: "dropdown-item" do
                  i.fa-solid.fa-clone.me-2
                  = "Duplizieren"

/ Fix to reset indeterminate state of select-all checkboxes on turbo:load
javascript:
  document.addEventListener("turbo:load", function() {
    document.querySelectorAll("input[data-checkbox-select-all-target='checkboxAll']").forEach(function(cb) {
      cb.indeterminate = false;
    });
  })
