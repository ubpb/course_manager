/ <%# locals: (offers:) -%>

/ The first step of a new event from the global list. The dialog fits the
/ event form that replaces the choice; a static backdrop keeps a click beside
/ it from throwing that form away.
#event-modal
  .modal.fade(tabindex="-1" aria-hidden="true" data-controller="modal" data-bs-backdrop="static")
    .modal-dialog.modal-lg.modal-dialog-centered.modal-dialog-scrollable
      = render "admin/events/form", offers: offers
