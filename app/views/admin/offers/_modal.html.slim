/ <%# locals: (offer:) -%>

/ A static backdrop: a click beside the long form must not throw it away.
#offer-modal
  .modal.fade(tabindex="-1" aria-hidden="true" data-controller="modal" data-bs-backdrop="static")
    .modal-dialog.modal-xl.modal-dialog-centered.modal-dialog-scrollable
      = render "admin/offers/form", offer: offer
