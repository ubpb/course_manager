/ <%# locals: (form:, offer:, event:, autofocus: false) -%>

- if form.object.errors.any?
  .alert.alert-danger.mb-3.text-center
    i.fa-solid.fa-exclamation-triangle.me-2
    = t("admin.application.form.error", count: form.object.errors.count)

h5.m-0 Allgemeine Angaben
hr.mt-1.mb-3
= form.input :published, as: :boolean
= form.input :date_and_time, html5: true, input_html: { autofocus: autofocus }
.row
  .col
    = form.input :duration
  .col
    = form.input :location
    = form.input :online, as: :boolean
    = form.input :online_url
.row
  .col
    = form.input :registration_required, as: :boolean
    = form.input :max_no_of_participants

= form.input :participant_notes, as: :text, input_html: { rows: 8 }

h5.mt-4.mb-0 Administrative Angaben
hr.mt-1.mb-3
= form.input :email_from

/ The previews take what the form currently holds, saved or not. They are
/ plain buttons, not submit buttons, so Enter in a text field still saves.
#mail-preview-modal
.d-flex.flex-wrap.gap-2(data-controller="mail-preview")
  button.btn.btn-outline-secondary(
    type="button"
    data-action="mail-preview#open"
    data-mail-preview-url-param=preview_confirmation_admin_offer_events_path(offer)
  )
    i.fa-regular.fa-eye.fa-fw.me-1
    = "Vorschau Anmeldebestätigung"
  button.btn.btn-outline-secondary(
    type="button"
    data-action="mail-preview#open"
    data-mail-preview-url-param=preview_reminder_admin_offer_events_path(offer)
  )
    i.fa-regular.fa-eye.fa-fw.me-1
    = "Vorschau Erinnerungsmail"
