- return_path = admin_offer_event_registrations_path(@offer, @event)

= render layout: "admin/offers/events/frame", locals: {offer: @offer, event: @event, active_tab: :report} do
  = simple_form_for @report, url: admin_offer_event_report_path(@offer, @event, @report) do |form|
    .card.card-shadowed
      .card-header.d-flex.align-items-center.gap-2
        h5.card-title.mb-0 = "Statistik"
        .ms-auto
        .dropdown
          button.btn.btn-outline-primary.btn-sm.dropdown-toggle(type="button" data-bs-toggle="dropdown")
            i.fas.fa-cog
          ul.dropdown-menu.dropdown-menu-end
            li
              = link_to admin_offer_event_report_path(@offer, @event, format: :xlsx), class: "dropdown-item" do
                i.fa-solid.fa-download.me-2
                = "Excel Export"
      .card-body
        = render "form_fields", form: form, offer: @offer, event: @event, report: @report
      .card-footer
        .d-flex.gap-2.flex-column.flex-md-row
          = form.submit t("admin.application.btn_save"), class: "btn btn-primary"
          = link_to t("admin.application.btn_cancel"), return_path, class: "btn btn-outline-secondary"
