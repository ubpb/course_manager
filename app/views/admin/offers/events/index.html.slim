= render layout: "admin/offers/frame", locals: {offer: @offer, active_tab: :events} do
  .card.card-shadowed
    .card-header.d-flex.align-items-center.gap-2
      h5.card-title.mb-0 = "Termine"
      .ms-auto
      = link_to new_admin_offer_event_path(@offer, nav_scope: "offer"), class: "btn btn-primary btn-sm" do
        i.fa-solid.fa-plus.me-2
        = "Neuen Termin anlegen"
    .card-body
      .mb-3 = render "application/filter_bar", filter: @filter, chips: admin_event_filter_chips(@filter), always: true, button_end: true
      - if @events.present?
        = render "admin/events/listing", events: @events, offer: @offer
      - else
        .p-2.text-muted = "Keine Termine vorhanden"

= render "application/filter_offcanvas", filter: @filter, filters_partial: "admin/events/filter_form", always: true,
                                         filters_locals: {url: admin_offer_events_path(@offer), show_title: false}
