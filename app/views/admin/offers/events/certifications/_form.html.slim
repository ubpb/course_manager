/ <%# locals: (offer:, event:, certification:) -%>

/ The certificate tab, for a new certificate as well as a saved one.
= render layout: "admin/offers/events/frame", locals: {offer: offer, event: event, active_tab: :certification} do
  = simple_form_for certification, url: admin_offer_event_certification_path(offer, event) do |form|
    .card.card-shadowed
      .card-header.d-flex.align-items-center.gap-2
        h5.card-title.mb-0 = "Zertifikat"
      .card-body
        = render "form_fields", form: form, offer: offer, event: event, certification: certification
      .card-footer
        .d-flex.gap-2.flex-column.flex-md-row
          = form.submit t("admin.application.btn_save"), class: "btn btn-primary"
          = link_to t("admin.application.btn_cancel"), admin_offer_event_registrations_path(offer, event), class: "btn btn-outline-secondary"
