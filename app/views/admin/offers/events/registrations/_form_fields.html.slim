/ <%# locals: (form:, autofocus: false) -%>

- if form.object.errors.any?
  .alert.alert-danger.mb-3.text-center
    i.fa-solid.fa-exclamation-triangle.me-2
    = t("admin.application.form.error", count: form.object.errors.count)

h5.m-0 Allgemeine Angaben
hr.mt-1.mb-3
.row
  .col = form.input :first_name, input_html: { autofocus: autofocus }
  .col = form.input :last_name
= form.input :email
= form.input :field_of_interest
= form.input :user_notes

h5.m-0 Interne Angaben
hr.mt-1.mb-3
- registration = form.object
- if registration.persisted? && registration.entered_in_admin?
  p.small.text-body-secondary
    i.fa-solid.fa-user-pen.fa-fw.me-2
    = "Im Admin eingetragen"
- elsif registration.persisted? && registration.account_linked?
  p.small.text-body-secondary
    i.fa-solid.fa-user-check.fa-fw.me-2
    = "Selbst angemeldet"
= form.input :internal_notes
= form.input :no_show, as: :boolean
