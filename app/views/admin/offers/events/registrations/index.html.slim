= render layout: "admin/offers/events/frame", locals: {offer: @offer, event: @event, active_tab: :registrations} do
  .card.card-shadowed
    .card-header.d-flex.align-items-center.gap-2
      h5.card-title.mb-0 = "Teilnehmer"
      .ms-auto
      = link_to new_admin_offer_event_registration_path(@offer, @event), class: "btn btn-primary btn-sm", data: {turbo_stream: true} do
        i.fa-solid.fa-plus.me-2
        = "Neuen Teilnehmer anlegen"
      .dropdown
        button.btn.btn-outline-primary.btn-sm.dropdown-toggle(type="button" data-bs-toggle="dropdown")
          i.fas.fa-cog
        ul.dropdown-menu.dropdown-menu-end
          li
            = link_to admin_offer_event_registrations_path(@offer, @event, format: :xlsx), class: "dropdown-item" do
              i.fa-solid.fa-download.me-2
              = "Excel Export"
    .card-body
      - if @registrations.present?
        = render "listing", offer: @offer, event: @event, registrations: @registrations
      - else
        .p-2.text-muted = "Keine Teilnehmer vorhanden"

  #registration-modal
