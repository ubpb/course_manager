- return_path = admin_offer_event_registrations_path(@offer, @event, anchor: dom_id(@registration))

= render layout: "admin/offers/events/frame", locals: {offer: @offer, event: @event, active_tab: :registrations} do
  / Only reached without Turbo; the list opens the form in a modal. Submitting
  / through Turbo would get the answers meant for the modal.
  = simple_form_for [:admin, @offer, @event, @registration], data: {turbo: false} do |form|
    .card.card-shadowed
      .card-header.d-flex.align-items-center.gap-2
        h5.card-title.mb-0 = "Neuer Teilnehmer"
      .card-body
        = render "form_fields", form: form
        = render "send_confirmation", event: @event
      .card-footer
        .d-flex.gap-2.flex-column.flex-md-row
          = form.submit t("admin.application.btn_save"), class: "btn btn-primary"
          = link_to t("admin.application.btn_cancel"), return_path, class: "btn btn-outline-secondary"
