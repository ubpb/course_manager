- return_path = admin_offer_event_registrations_path(@offer, @event, anchor: dom_id(@registration))

= simple_form_for [:admin, @offer, @event, @registration] do |form|
  .card.card-shadowed
    .card-header.d-flex.align-items-center.gap-2
      h5.card-title.mb-0 = "Neuen Teilnehmer anlegen"
      .ms-auto
      = link_to return_path, class: "btn btn-link btn-sm" do
        i.fa-solid.fa-times
    .card-body
      = render "form_fields", form: form

      h5.m-0 Benachrichtigung
      hr.mt-1.mb-3
      .form-check
        = hidden_field_tag :send_confirmation, "0", id: nil
        / Preselected for upcoming events only: after the event a "thank you for
        / registering" would only confuse (staff add attendees for certificates).
        = check_box_tag :send_confirmation, "1", params.fetch(:send_confirmation, @event.upcoming? ? "1" : "0") == "1", class: "form-check-input"
        = label_tag :send_confirmation, "Anmeldebestätigung senden", class: "form-check-label"
    .card-footer
      .d-flex.gap-2.flex-column.flex-md-row
        = form.submit t("admin.application.btn_save"), class: "btn btn-primary"
        = link_to t("admin.application.btn_cancel"), return_path, class: "btn btn-outline-secondary"
