/ <%# locals: (offer:, active_tab:) -%>

/ Head and tabs around the parts of an offer. Only courses have events. After
/ a failed save the head shows the offer as stored, not the invalid input.
- stored = offer.changed? ? Offer.find(offer.id) : offer
- tabs = []
- tabs << [:events, "Termine", admin_offer_events_path(stored), stored.events.size] if stored.course?
- tabs << [:offer, "Angebotsdaten", edit_admin_offer_path(stored), nil]

.context-head.context-head-offer
  .d-flex.flex-column.flex-md-row.gap-3
    .flex-grow-1
      .context-head-overline = offer_type_label(stored)
      h2.context-head-title = stored.title
      .d-flex.flex-wrap.gap-2
        = published_badge(stored)
        - if stored.archived?
          span.badge.text-bg-secondary = "archiviert"
        - if stored.course?
          span.badge.text-bg-light.border = "#{stored.events.upcoming.count} kommende"
          span.badge.text-bg-light.border = "#{stored.events.past.count} vergangene"
    .d-flex.flex-column.align-items-md-end.gap-2
      = link_to admin_offers_path(anchor: dom_id(stored), nav_scope: nil), class: "text-nowrap" do
        i.fa-solid.fa-arrow-left.me-1
        = "Zurück zur Angebotsliste"
      - if stored.published? && !stored.archived?
        = link_to frontend_offer_path(stored), class: "btn btn-outline-primary btn-sm", target: "_blank", rel: "noopener" do
          i.fa-solid.fa-arrow-up-right-from-square.me-1
          = "Im Frontend"

.row.g-4
  .col-lg-3.col-xl-2
    nav.nav.nav-pills.flex-lg-column.gap-1.offer-tabs(aria-label="Bereiche des Angebots")
      - tabs.each do |key, label, path, count|
        = link_to path, class: ["nav-link", ("active" if key == active_tab)], "aria-current": ("page" if key == active_tab) do
          = label
          - if count
            span.badge.rounded-pill.text-bg-light.ms-2 = count
  .col-lg-9.col-xl-10
    = yield
