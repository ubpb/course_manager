.d-lg-flex.justify-content-between.align-items-center.gap-2.mb-4
  h3.mb-lg-0.fw-bold
    = @offer.title
    span.ms-2 = render "status_badge", event: @event
  div
    = link_to account_root_path, class: "btn btn-outline-primary btn-sm text-nowrap" do
      i.fa-solid.fa-arrows-turn-right.fa-flip-horizontal.fa-fw.me-1
      span = t(".back")

= render "content", registration: @registration
