/ <%# locals: (registration:) -%>

#registration-modal
  .modal.fade(tabindex="-1" aria-hidden="true" data-controller="modal")
    .modal-dialog.modal-xl.modal-dialog-centered.modal-dialog-scrollable
      .modal-content
        .modal-header
          h5.modal-title
            = registration.event.offer.title
            = render "account/registrations/status_badge", event: registration.event
          button.btn-close(type="button" data-bs-dismiss="modal" aria-label=t("account.registrations.show.close"))
        .modal-body
          = render "account/registrations/content", registration: registration
        .modal-footer
          button.btn.btn-outline-secondary(type="button" data-bs-dismiss="modal") = t("account.registrations.show.close")
